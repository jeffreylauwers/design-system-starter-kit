{
  "name": "TextInput",
  "cssBlock": "dsn-text-input",
  "category": "form-input",
  "purpose": "Single-line text input with an optional wrapper for inline icons or prefix/suffix labels.",
  "platforms": ["html-css", "react"],
  "primaryProps": [
    {
      "name": "disabled",
      "type": "boolean",
      "default": false
    },
    {
      "name": "invalid",
      "type": "boolean",
      "default": false
    },
    {
      "name": "inlineSize",
      "values": ["xs", "sm", "md", "lg", "xl", "full"],
      "default": "full"
    }
  ]
}
