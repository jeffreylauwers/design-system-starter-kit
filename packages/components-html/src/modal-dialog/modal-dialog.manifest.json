            "kind": "slot",
            "property": "body"
          }
        ]
      },
      {
        "name": "footer",
        "element": "dsn-modal-dialog__footer",
        "description": "De acties onderaan.",
        "figma": [
          {
            "kind": "slot",
            "property": "footer"
          }
        ]
      }
    ],
    "states": [
