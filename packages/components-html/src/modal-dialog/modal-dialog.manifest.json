{
  "name": "ModalDialog",
  "cssBlock": "dsn-modal-dialog",
  "category": "display-feedback",
  "purpose": "Modal dialog for short focused actions; blocks the background via native <dialog> with a focus trap.",
  "platforms": ["html-css", "react"],
  "primaryProps": [],
  "api": {
    "props": [
      {
        "name": "isOpen",
        "type": "boolean",
        "required": true,
        "figma": [
          {
            "kind": "none",
            "reason": "Altijd open in Figma: open en dicht is gedrag."
          }
        ]
      },
      {
        "name": "onClose",
        "type": "function",
        "figma": [
          {
            "kind": "none",
            "reason": "Gedrag, geen uiterlijk."
          }
        ]
      },
      {
        "name": "triggerRef",
        "type": "object",
        "figma": [
          {
            "kind": "none",
            "reason": "Gedrag, geen uiterlijk."
          }
        ]
      },
      {
        "name": "alert",
        "type": "boolean",
        "default": false,
        "figma": [
          {
            "kind": "none",
            "reason": "Nog niet in de Figma-matrix van ModalDialog.",
            "open": true
          }
        ]
      },
      {
        "name": "children",
