{
  "name": "RadioOption",
  "cssBlock": "dsn-radio-option",
  "category": "form-option",
  "purpose": "Composite of Radio and OptionLabel for a single labelled radio option.",
  "platforms": ["html-css", "react"],
  "primaryProps": [
    {
      "name": "label",
      "type": "string",
      "required": true
    },
    {
      "name": "checked",
      "type": "boolean",
      "default": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false
    }
  ]
}
