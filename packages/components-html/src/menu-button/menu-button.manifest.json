{
  "name": "MenuButton",
  "cssBlock": "dsn-menu-button",
  "category": "navigation",
  "purpose": "Navigation button for JavaScript actions (logout, open modal); semantically a <button>, visually consistent with MenuLink.",
  "platforms": ["html-css", "react"],
  "primaryProps": [],
  "api": {
    "props": [
      {
        "name": "iconStart",
        "type": "ReactNode",
        "slots": ["icon-start"]
      },
      {
        "name": "iconEnd",
        "type": "ReactNode",
        "slots": ["icon-end"]
      },
      {
        "name": "dotBadge",
        "type": "ReactNode",
        "slots": ["dot-badge"]
      },
      {
        "name": "type",
        "type": "string",
        "default": "button",
        "native": true,
        "figma": [
          {
            "kind": "none",
            "reason": "Bepaalt gedrag in een formulier, niet het uiterlijk."
          }
        ]
      },
      {
        "name": "children",
        "type": "ReactNode",
        "slots": ["label"]
      }
    ],
    "slots": [
      {
        "name": "icon-start",
        "element": "dsn-icon",
        "description": "Icoon vóór de tekst.",
        "figma": [
          {
            "kind": "boolean",
            "property": "showIconStart"
          },
          {
            "kind": "instance-swap",
            "property": "iconStart"
          }
        ]
      },
      {
        "name": "label",
        "element": "dsn-menu-button",
        "description": "De tekst.",
        "figma": [
          {
            "kind": "text",
            "property": "label"
          }
        ]
      },
      {
        "name": "icon-end",
        "element": "dsn-icon",
        "description": "Icoon na de tekst.",
        "figma": [
          {
            "kind": "boolean",
            "property": "showIconEnd"
          },
          {
            "kind": "instance-swap",
            "property": "iconEnd"
          }
        ]
      },
      {
        "name": "dot-badge",
        "element": "dsn-dot-badge",
        "description": "Een DotBadge in de hoek van de knop.",
        "figma": [
          {
            "kind": "boolean",
            "property": "showDotBadge"
          }
        ]
      }
    ],
    "states": [
      {
        "name": "hover",
        "selector": ":hover",
        "figma": [
          {
            "kind": "variant",
            "property": "state",
            "value": "hover"
          }
        ]
      },
      {
        "name": "active",
        "selector": ":active",
        "figma": [
          {
            "kind": "variant",
            "property": "state",
            "value": "active"
          }
        ]
      },
      {
        "name": "focus-visible",
        "selector": ":focus-visible",
        "figma": [
          {
            "kind": "none",
            "reason": "In Figma kun je niet met de tabtoets door een prototype; Figma is voor het snel uitwerken van ideeën, niet voor toetsenbordgedrag."
          }
        ]
      }
    ]
  }
}
