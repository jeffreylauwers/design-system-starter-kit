{
  "name": "Spinner",
  "cssBlock": "dsn-spinner",
  "category": "display-feedback",
  "purpose": "Circular loading indicator for indeterminate wait times with role=\"status\" and a required accessible label.",
  "platforms": ["html-css", "react"],
  "primaryProps": [
    {
      "name": "size",
      "values": ["default", "large"],
      "default": "default"
    },
    {
      "name": "hideLabel",
      "type": "boolean",
      "default": false
    }
  ],
  "api": {
    "props": [
      {
        "name": "label",
        "type": "string",
        "required": true,
        "figma": [
          {
            "kind": "text",
            "property": "label"
          }
        ]
      },
      {
        "name": "hideLabel",
        "type": "boolean",
        "default": false,
        "figma": [
          {
            "kind": "none",
            "reason": "Een visueel verborgen label slaat de extractor over, en dan heeft de label-property in die variant geen laag. Wie in Figma een spinner zonder label wil, zet de tekstlaag uit (zie de matrix)."
          }
        ]
      },
      {
        "name": "size",
        "values": ["default", "large"],
        "default": "default",
        "figma": [
          {
            "kind": "variant",
            "property": "size"
          }
        ]
      }
    ],
    "slots": [],
    "states": []
  }
}
