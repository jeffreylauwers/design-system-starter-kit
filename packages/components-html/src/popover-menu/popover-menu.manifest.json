{
  "name": "PopoverMenu",
  "cssBlock": "dsn-popover-menu",
  "category": "navigation",
  "purpose": "List of actions or links in a floating panel opened from a trigger button; no dialog role, light-dismissed via the HTML Popover API.",
  "platforms": ["html-css", "react"],
  "primaryProps": [
    {
      "name": "placement",
      "values": ["top", "bottom", "start", "end"],
      "default": "bottom"
    }
  ],
  "api": {
    "props": [
      {
        "name": "isOpen",
        "type": "boolean",
        "required": true,
        "figma": [
          {
            "kind": "none",
            "reason": "Altijd open in Figma: open en dicht is gedrag."
          }
        ]
      },
      {
        "name": "onClose",
        "type": "function",
        "figma": [
          {
            "kind": "none",
            "reason": "Gedrag, geen uiterlijk."
          }
        ]
      },
      {
        "name": "triggerRef",
        "type": "object",
        "required": true,
        "figma": [
          {
            "kind": "none",
            "reason": "Gedrag, geen uiterlijk."
          }
        ]
      },
      {
        "name": "placement",
        "values": ["top", "bottom", "start", "end"],
        "default": "bottom",
        "figma": [
          {
            "kind": "none",
            "reason": "De plek ten opzichte van de trigger. In Figma is de set alleen het paneel, en zet een designer dat zelf op zijn plek."
          }
        ]
      },
      {
        "name": "iconStart",
        "type": "boolean",
        "default": false,
        "figma": [
          {
            "kind": "none",
            "reason": "Gaat door naar Menu (dsn-menu--icon-start), en volgt daarom het open punt iconStart bij Menu.",
            "open": true
          }
        ]
      },
      {
        "name": "children",
        "type": "ReactNode",
        "slots": ["items"]
      }
    ],
    "slots": [
      {
        "name": "items",
        "element": "dsn-menu",
        "description": "De lijst met MenuButtons of MenuLinks.",
        "figma": [
          {
            "kind": "slot",
            "property": "items"
          }
        ]
      }
    ],
    "states": []
  }
}
