{
  "name": "MenuLink",
  "cssBlock": "dsn-menu-link",
  "category": "navigation",
  "purpose": "Navigation link with level hierarchy (1–4), active page state, and expandable sub-navigation.",
  "platforms": ["html-css", "react"],
  "primaryProps": [
    {
      "name": "href",
      "type": "string"
    },
    {
      "name": "level",
      "values": [1, 2, 3, 4],
      "default": 1
    },
    {
      "name": "current",
      "type": "boolean",
      "default": false
    },
    {
      "name": "expanded",
      "type": "boolean",
      "default": false
    }
  ],
  "api": {
    "props": [
      {
        "name": "href",
        "type": "string",
        "figma": [
          {
            "kind": "none",
            "reason": "De bestemming van de link, niet het uiterlijk."
          }
        ]
      },
      {
        "name": "level",
        "values": [1, 2, 3, 4],
        "default": 1,
        "figma": [
          {
            "kind": "variant",
            "property": "level"
          }
        ]
      },
      {
        "name": "current",
        "type": "boolean",
        "default": false,
        "figma": [
          {
            "kind": "variant",
            "property": "state",
            "value": "current"
          }
        ]
      },
      {
        "name": "iconStart",
        "type": "ReactNode",
        "slots": ["icon-start"]
      },
      {
        "name": "iconEnd",
        "type": "ReactNode",
        "slots": ["icon-end"]
      },
      {
        "name": "numberBadge",
        "type": "ReactNode",
        "slots": ["number-badge"]
      },
      {
        "name": "subItems",
        "type": "boolean",
        "default": false,
        "figma": [
          {
            "kind": "variant",
            "property": "expand",
            "values": ["with-expand", "no-expand"]
          }
        ]
      },
      {
        "name": "expanded",
        "type": "boolean",
        "default": false,
        "figma": [
          {
            "kind": "variant",
            "property": "expanded"
          }
        ]
      },
      {
        "name": "onExpandToggle",
        "type": "function",
        "figma": [
          {
            "kind": "none",
            "reason": "Gedrag, geen uiterlijk."
          }
        ]
      },
      {
        "name": "children",
        "type": "ReactNode",
        "slots": ["label"]
      }
    ],
    "slots": [
      {
        "name": "label",
        "element": "dsn-menu-link",
        "description": "De tekst van de link.",
        "figma": [
          {
            "kind": "none",
            "reason": "Geen property: de inhoud pas je in een instance aan op de lagen zelf."
          }
        ]
      },
      {
        "name": "icon-start",
        "element": "dsn-icon",
        "description": "Icoon vóór het label.",
        "figma": [
          {
            "kind": "boolean",
            "property": "showIconStart"
          },
          {
            "kind": "instance-swap",
            "property": "iconStart"
          }
        ]
      },
      {
        "name": "number-badge",
        "element": "dsn-number-badge",
        "description": "Een NumberBadge achter het label.",
        "figma": [
          {
            "kind": "boolean",
            "property": "showNumberBadge"
          }
        ]
      },
      {
        "name": "icon-end",
        "element": "dsn-icon",
        "description": "Icoon achter het label.",
        "figma": [
          {
            "kind": "boolean",
            "property": "showIconEnd"
          },
          {
            "kind": "instance-swap",
            "property": "iconEnd"
          }
        ]
      }
    ],
    "states": [
      {
        "name": "hover",
        "selector": ":hover",
        "figma": [
          {
            "kind": "variant",
            "property": "interaction",
            "value": "hover"
          }
        ]
      },
      {
        "name": "active",
        "selector": ":active",
        "figma": [
          {
            "kind": "variant",
            "property": "interaction",
            "value": "active"
          }
        ]
      },
      {
        "name": "focus-visible",
        "selector": ":focus-visible",
        "figma": [
          {
            "kind": "none",
            "reason": "In Figma kun je niet met de tabtoets door een prototype; Figma is voor het snel uitwerken van ideeën, niet voor toetsenbordgedrag."
          }
        ]
      }
    ]
  }
}
