{
  "name": "Radio",
  "cssBlock": "dsn-radio",
  "category": "form-option",
  "purpose": "Custom styled radio button with an inner circle indicator.",
  "platforms": ["html-css", "react"],
  "primaryProps": [
    {
      "name": "checked",
      "type": "boolean",
      "default": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false
    }
  ],
  "api": {
    "props": [
      {
        "name": "invalid",
        "type": "boolean",
        "default": false,
        "figma": [
          {
            "kind": "variant",
            "property": "invalid"
          }
        ]
      },
      {
        "name": "checked",
        "type": "boolean",
        "default": false,
        "native": true,
        "figma": [
          {
            "kind": "variant",
            "property": "state",
            "value": "checked"
          }
        ]
      },
      {
        "name": "disabled",
        "type": "boolean",
        "default": false,
        "native": true,
        "figma": [
          {
            "kind": "variant",
            "property": "disabled"
          }
        ]
      }
    ],
    "slots": [],
    "states": [
      {
        "name": "hover",
        "selector": ":hover",
        "figma": [
          {
            "kind": "variant",
            "property": "interaction",
            "value": "hover"
          }
        ]
      },
      {
        "name": "active",
        "selector": ":active",
        "figma": [
          {
            "kind": "variant",
            "property": "interaction",
            "value": "active"
          }
        ]
      },
      {
        "name": "focus-visible",
        "selector": ":focus-visible",
        "figma": [
          {
            "kind": "none",
            "reason": "In Figma kun je niet met de tabtoets door een prototype; Figma is voor het snel uitwerken van ideeën, niet voor toetsenbordgedrag."
          }
        ]
      }
    ]
  }
}
