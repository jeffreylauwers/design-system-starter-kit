{
  "name": "File",
  "cssBlock": "dsn-file",
  "category": "display-feedback",
  "purpose": "Displays file metadata (name, type, size) with contextual upload states and an optional interactive variant.",
  "platforms": ["html-css", "react"],
  "primaryProps": [
    {
      "name": "status",
      "values": ["default", "loading", "uploaded", "error"],
      "default": "default"
    },
    {
      "name": "ctaVariant",
      "values": ["view", "download"],
      "default": "view"
    },
    {
      "name": "mediaType",
      "values": ["document", "image"],
      "default": "document"
    }
  ],
  "api": {
    "props": [
      {
        "name": "fileName",
        "type": "string",
        "required": true,
        "figma": [
          {
            "kind": "text",
            "property": "fileName"
          }
        ]
      },
      {
        "name": "fileType",
        "type": "string",
        "slots": ["meta"]
      },
      {
        "name": "fileSize",
        "type": "string",
        "slots": ["meta"]
      },
      {
        "name": "status",
        "values": ["default", "loading", "uploaded", "error"],
        "default": "default",
        "figma": [
          {
            "kind": "variant",
            "property": "status"
          }
        ]
      },
      {
        "name": "errorMessage",
        "type": "string",
        "figma": [
          {
            "kind": "text",
            "property": "label",
            "instance": "FormFieldErrorMessage"
          }
        ]
      },
      {
        "name": "href",
        "type": "string",
        "slots": ["actions"]
      },
      {
        "name": "onDelete",
        "type": "function",
        "slots": ["actions"]
      },
      {
        "name": "deleteLabel",
        "type": "string",
        "default": "Verwijder",
        "slots": ["action-label"]
      },
      {
        "name": "ctaVariant",
        "values": ["view", "download"],
        "default": "view",
        "figma": [
          {
            "kind": "none",
            "reason": "Zit in de as actions: view (de hele rij klikbaar) of download (een aparte knop)."
          }
        ]
      },
      {
        "name": "ctaLabel",
        "type": "string",
        "slots": ["action-label"]
      },
      {
        "name": "mediaType",
        "values": ["document", "image"],
        "default": "document",
        "figma": [
          {
            "kind": "instance-swap",
            "property": "mediaIcon",
            "reason": "Verandert alleen het icoon in het media-vlak (file-description of photo), geen token."
          }
        ]
      },
      {
        "name": "previewSrc",
        "type": "string",
        "figma": [
          {
            "kind": "boolean",
            "property": "showPreview",
            "reason": "Zet een preview-laag over het media-vlak; de afbeelding zelf zet een designer erin als image fill."
          }
        ]
      },
      {
        "name": "loadingLabel",
        "type": "string",
        "default": "Bezig met uploaden",
        "figma": [
          {
            "kind": "none",
            "reason": "Visueel verborgen: het label van de Spinner of de tekst in de aria-live regio. Er is niets van te zien."
          }
        ]
      },
      {
        "name": "uploadedLabel",
        "type": "string",
        "figma": [
          {
            "kind": "none",
            "reason": "Visueel verborgen: het label van de Spinner of de tekst in de aria-live regio. Er is niets van te zien."
          }
        ]
      },
      {
        "name": "errorLabel",
        "type": "string",
        "figma": [
          {
            "kind": "none",
            "reason": "Visueel verborgen: het label van de Spinner of de tekst in de aria-live regio. Er is niets van te zien."
          }
        ]
      }
    ],
    "slots": [
      {
        "name": "meta",
        "element": "dsn-file__meta",
        "description": "Bestandstype en -grootte als één tekst, zoals React ze samenvoegt: \"PDF · 1,2 MB\".",
        "figma": [
          {
            "kind": "text",
            "property": "meta"
          }
        ]
      },
      {
        "name": "actions",
        "element": "dsn-file__actions",
        "description": "De knoppen om het bestand te bekijken of te verwijderen.",
        "figma": [
          {
            "kind": "variant",
            "property": "actions",
            "values": ["none", "delete", "view", "download"],
            "reason": "In React volgen de acties uit onDelete (delete), href (view) en ctaVariant=download (download)."
          }
        ]
      },
      {
        "name": "action-label",
        "element": "dsn-link",
        "description": "Het label van de knop in de actie-kolom: verwijderen (deleteLabel) of downloaden (ctaLabel). In Figma de label van de Link-instance.",
        "figma": [
          {
            "kind": "text",
            "property": "label",
            "instance": "Link"
          }
        ]
      }
    ],
    "states": [
      {
        "name": "hover",
        "selector": ":hover",
        "figma": [
          {
            "kind": "variant",
            "property": "state",
            "value": "hover",
            "reason": "Alleen bij actions=view: alleen de klikbare rij heeft deze stijlen."
          }
        ]
      },
      {
        "name": "active",
        "selector": ":active",
        "figma": [
          {
            "kind": "variant",
            "property": "state",
            "value": "active",
            "reason": "Alleen bij actions=view: alleen de klikbare rij heeft deze stijlen."
          }
        ]
      },
      {
        "name": "focus-visible",
        "selector": ":focus-visible",
        "figma": [
          {
            "kind": "none",
            "reason": "In Figma kun je niet met de tabtoets door een prototype; Figma is voor het snel uitwerken van ideeën, niet voor toetsenbordgedrag."
          }
        ]
      }
    ]
  }
}
