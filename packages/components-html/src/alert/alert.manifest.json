{
  "name": "Alert",
  "cssBlock": "dsn-alert",
  "category": "display-feedback",
  "purpose": "Live region message that informs the user of an important status related to the current activity.",
  "platforms": ["html-css", "react"],
  "primaryProps": [
    {
      "name": "variant",
      "values": ["info", "positive", "negative", "warning"],
      "default": "info"
    }
  ],
  "api": {
    "props": [
      {
        "name": "variant",
        "values": ["info", "positive", "negative", "warning"],
        "default": "info",
        "figma": [
          {
            "kind": "variant",
            "property": "variant"
          }
        ]
      },
      {
        "name": "heading",
        "type": "string",
        "required": true,
        "figma": [
          {
            "kind": "text",
            "property": "label",
            "instance": "Heading"
          }
        ]
      },
      {
        "name": "headingLevel",
        "values": [1, 2, 3, 4, 5, 6],
        "default": 2,
        "figma": [
          {
            "kind": "none",
            "reason": "Bepaalt het HTML-element van de kop; die ziet er altijd uit als heading-3."
          }
        ]
      },
      {
        "name": "iconStart",
        "type": "ReactNode",
        "slots": ["icon"]
      },
      {
        "name": "variantLabel",
        "type": "string",
        "figma": [
          {
            "kind": "none",
            "reason": "Tekst voor schermlezers; niet zichtbaar."
          }
        ]
      },
      {
        "name": "children",
        "type": "ReactNode",
        "slots": ["content"]
      }
    ],
    "slots": [
      {
        "name": "icon",
        "element": "dsn-alert__icon",
        "description": "Het icoon; standaard dat van de variant, null haalt het weg.",
        "figma": [
          {
            "kind": "variant",
            "property": "icon",
            "values": ["with-icon", "no-icon"]
          }
        ]
      },
      {
        "name": "content",
        "element": "dsn-alert__content",
        "description": "De tekst van de melding.",
        "figma": [
          {
            "kind": "text",
            "property": "label",
            "instance": "Paragraph"
          }
        ]
      }
    ],
    "states": []
  }
}
