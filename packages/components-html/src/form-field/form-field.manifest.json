{
  "name": "FormField",
  "cssBlock": "dsn-form-field",
  "category": "form-field",
  "purpose": "Container that assembles FormFieldLabel, FormFieldDescription, FormFieldErrorMessage, FormFieldStatus, and a single form input.",
  "platforms": ["html-css", "react"],
  "primaryProps": [
    {
      "name": "label",
      "type": "string",
      "required": true
    },
    {
      "name": "error",
      "type": "ReactNode"
    }
  ],
  "api": {
    "props": [
      {
        "name": "label",
        "type": "string",
        "required": true,
        "figma": [
          {
            "kind": "text",
            "property": "label",
            "instance": "FormFieldLabel"
          }
        ]
      },
      {
        "name": "htmlFor",
        "type": "string",
        "figma": [
          {
            "kind": "none",
            "reason": "Koppelt elementen in code, niet het uiterlijk."
          }
        ]
      },
      {
        "name": "labelSuffix",
        "type": "string",
        "figma": [
          {
            "kind": "boolean",
            "property": "showSuffix",
            "instance": "FormFieldLabel"
          },
          {
            "kind": "text",
            "property": "suffix",
            "instance": "FormFieldLabel"
          }
        ]
      },
      {
        "name": "description",
        "type": "ReactNode",
        "figma": [
          {
            "kind": "variant",
            "property": "description",
            "values": ["with-description", "no-description"]
          },
          {
            "kind": "text",
            "property": "label",
            "instance": "FormFieldDescription"
          }
        ]
      },
      {
        "name": "error",
        "type": "ReactNode",
        "figma": [
          {
            "kind": "variant",
            "property": "invalid"
          },
          {
            "kind": "text",
            "property": "label",
            "instance": "FormFieldErrorMessage"
          }
        ]
      },
      {
        "name": "status",
        "type": "ReactNode",
        "figma": [
          {
            "kind": "none",
            "reason": "Nog niet in de Figma-matrix van FormField.",
            "open": true
          }
        ]
      },
      {
        "name": "statusVariant",
        "values": ["default", "positive", "warning"],
        "default": "default",
        "figma": [
          {
            "kind": "none",
            "reason": "Nog niet in de Figma-matrix van FormField.",
            "open": true
          }
        ]
      },
      {
        "name": "statusLive",
        "type": "boolean",
        "default": false,
        "figma": [
          {
            "kind": "none",
            "reason": "Bepaalt of schermlezers een wijziging voorlezen (aria-live); niet zichtbaar."
          }
        ]
      },
      {
        "name": "children",
        "type": "ReactNode",
        "required": true,
        "slots": ["control"]
      }
    ],
    "slots": [
      {
        "name": "control",
        "element": "dsn-form-field",
        "description": "Het formulierveld zelf, zoals een TextInput.",
        "figma": [
          {
            "kind": "none",
            "reason": "Geen property: de inhoud pas je in een instance aan op de lagen zelf."
          }
        ]
      }
    ],
    "states": []
  }
}
