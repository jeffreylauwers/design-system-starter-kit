{
  "name": "ActionGroup",
  "cssBlock": "dsn-action-group",
  "category": "layout",
  "purpose": "Groups related actions (buttons and links) horizontally or vertically with automatic wrapping.",
  "platforms": ["html-css", "react"],
  "primaryProps": [
    {
      "name": "direction",
      "values": ["horizontal", "vertical"],
      "default": "horizontal"
    }
  ],
  "api": {
    "props": [
      {
        "name": "direction",
        "values": ["horizontal", "vertical"],
        "default": "horizontal",
        "figma": [
          {
            "kind": "variant",
            "property": "direction"
          }
        ]
      },
      {
        "name": "aria-label",
        "type": "string",
        "default": "Acties",
        "native": true,
        "figma": [
          {
            "kind": "none",
            "reason": "Tekst voor schermlezers; niet zichtbaar."
          }
        ]
      },
      {
        "name": "children",
        "type": "ReactNode",
        "slots": ["actions"]
      }
    ],
    "slots": [
      {
        "name": "actions",
        "element": "dsn-action-group",
        "description": "De knoppen en links.",
        "figma": [
          {
            "kind": "slot",
            "property": "slot"
          }
        ]
      }
    ],
    "states": []
  }
}
