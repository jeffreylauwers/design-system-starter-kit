          }
        ]
      },
      {
        "name": "body",
        "element": "dsn-card__body",
        "description": "De inhoud (CardBody).",
        "figma": [
          {
            "kind": "none",
            "reason": "Geen property: de inhoud pas je in een instance aan op de lagen zelf."
          }
        ]
      },
      {
        "name": "footer",
