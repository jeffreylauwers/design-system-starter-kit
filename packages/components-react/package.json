{
  "name": "@dsn-starter-kit/components-react",
  "version": "2.0.0",
  "description": "React components for the design system",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": "./dist/index.css",
    "./icon-registry.generated": {
      "types": "./dist/Icon/icon-registry.generated.d.ts",
      "import": "./dist/Icon/icon-registry.generated.js",
      "default": "./dist/Icon/icon-registry.generated.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:icons": "node scripts/generate-icons.js",
    "build": "node scripts/generate-icons.js && node scripts/build-css.js && tsc",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "keywords": [
    "design-system",
    "react",
    "components"
  ],
  "author": "Jeffrey Lauwers",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dsn-starter-kit/core": "workspace:*",
    "@dsn-starter-kit/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3"
  }
}
