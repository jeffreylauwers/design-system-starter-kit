{
  "name": "@dsn-starter-kit/components-react",
  "version": "3.0.0",
  "description": "React components for the design system",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:icons": "node scripts/generate-icons.js",
    "build": "node scripts/generate-icons.js && tsdown",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "keywords": [
    "design-system",
    "react",
    "components"
  ],
  "author": "Jeffrey Lauwers",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dsn-starter-kit/core": "workspace:*",
    "@dsn-starter-kit/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "tsdown": "^0.22.14"
  }
}
