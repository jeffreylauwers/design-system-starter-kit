{
  "name": "@dsn-starter-kit/components-react",
  "version": "5.0.0",
  "description": "React components for the design system",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./css": {
      "types": "./css.d.ts",
      "default": "./dist/index.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "css.d.ts"
  ],
  "scripts": {
    "generate:icons": "node scripts/generate-icons.js",
    "build": "node scripts/generate-icons.js && tsdown",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "keywords": [
    "design-system",
    "react",
    "components"
  ],
  "author": "Jeffrey Lauwers",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dsn-starter-kit/core": "workspace:*",
    "@dsn-starter-kit/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.5",
    "typescript": "~6.0.3"
  }
}
