{
  "name": "@dsn-starter-kit/components-web",
  "version": "3.3.0",
  "description": "Web Components for the design system",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build-css.js && tsdown",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "keywords": [
    "design-system",
    "web-components",
    "custom-elements"
  ],
  "author": "Jeffrey Lauwers",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dsn-starter-kit/components-html": "workspace:*",
    "@dsn-starter-kit/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsdown": "^0.22.14"
  }
}
