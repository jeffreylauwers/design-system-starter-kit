{
  "name": "@dsn-starter-kit/design-tokens",
  "version": "3.3.0",
  "description": "Design tokens for the design system",
  "type": "module",
  "main": "dist/js/tokens.cjs",
  "module": "dist/js/tokens.js",
  "types": "dist/js/tokens.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/js/tokens.d.ts",
        "default": "./dist/js/tokens.js"
      },
      "require": {
        "types": "./dist/js/tokens.d.cts",
        "default": "./dist/js/tokens.cjs"
      }
    },
    "./dark": {
      "import": {
        "types": "./dist/js/tokens-dark.d.ts",
        "default": "./dist/js/tokens-dark.js"
      },
      "require": {
        "types": "./dist/js/tokens-dark.d.cts",
        "default": "./dist/js/tokens-dark.cjs"
      }
    },
    "./css": {
      "types": "./css.d.ts",
      "default": "./dist/css/variables.css"
    },
    "./css/dark": {
      "types": "./css.d.ts",
      "default": "./dist/css/variables-dark.css"
    },
    "./css/dark-scoped": {
      "types": "./css.d.ts",
      "default": "./dist/css/variables-dark-scoped.css"
    },
    "./scss": {
      "types": "./css.d.ts",
      "default": "./dist/scss/_variables.scss"
    },
    "./scss/dark": {
      "types": "./css.d.ts",
      "default": "./dist/scss/_variables-dark.scss"
    },
    "./css/scoped/start-hero-image-light": {
      "types": "./css.d.ts",
      "default": "./dist/css/scoped/start-light-hero-image.css"
    },
    "./css/scoped/wireframe-hero-image-light": {
      "types": "./css.d.ts",
      "default": "./dist/css/scoped/wireframe-light-hero-image.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist",
    "css.d.ts"
  ],
  "scripts": {
    "build": "node src/config/build.js && tsdown",
    "build:figma": "node src/config/build-figma.js",
    "clean": "rm -rf dist",
    "watch": "node --watch-path=src src/config/build.js"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "style-dictionary"
  ],
  "author": "Jeffrey Lauwers",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "style-dictionary": "^4.0.0",
    "tsdown": "^0.22.14"
  }
}
