{
  "dsn": {
    "page-header": {
      "background-color": {
        "$value": "{dsn.color.neutral.bg-document}",
        "$type": "color",
        "$description": "Achtergrondkleur."
      },
      "border-block-end-width": {
        "$value": "{dsn.border.width.thick}",
        "$type": "dimension",
        "$description": "Lijndikte van de rand aan de onderkant."
      },
      "border-block-end-color": {
        "$value": "{dsn.color.accent-1.color-default}",
        "$type": "color",
        "$description": "Lijnkleur van de rand aan de onderkant."
      },
      "padding-block": {
        "$value": "{dsn.space.block.md}",
        "$type": "spacing",
        "$description": "Ruimte boven en onder de inhoud."
      },
      "padding-inline": {
        "$value": "{dsn.space.inline.xl}",
        "$type": "spacing",
        "$description": "Ruimte aan begin en eind van de inhoud."
      },
      "z-index": {
        "$value": "{dsn.z-index.300}",
        "$type": "number",
        "$description": "Stapellaag van de paginakop als die in beeld blijft bij scrollen. Lager dan de verduistering, zodat een paneel of dialoog eroverheen schuift."
      },
      "logo": {
        "max-block-size": {
          "$value": "2rem",
          "$type": "dimension",
          "$description": "Maximale hoogte van het logo."
        }
      },
      "masthead": {
        "background-color": {
          "$value": "{dsn.color.neutral.bg-document}",
          "$type": "color",
          "$description": "Achtergrondkleur van de bovenbalk."
        },
        "padding-block": {
          "$value": "{dsn.space.block.xl}",
          "$type": "spacing",
          "$description": "Ruimte boven en onder de inhoud van de bovenbalk."
        },
        "padding-inline": {
          "$value": "{dsn.space.inline.xl}",
          "$type": "spacing",
          "$description": "Ruimte aan begin en eind van de inhoud van de bovenbalk."
        }
      },
      "navbar": {
        "background-color": {
          "$value": "{dsn.color.accent-1.bg-default}",
          "$type": "color",
          "$description": "Achtergrondkleur van de navigatiebalk."
        },
        "padding-inline": {
          "$value": "{dsn.space.inline.xl}",
          "$type": "spacing",
          "$description": "Ruimte aan begin en eind van de inhoud van de navigatiebalk."
        }
      },
      "secondary-nav": {
        "gap": {
          "$value": "{dsn.space.column.3xl}",
          "$type": "spacing",
          "$description": "Ruimte tussen de onderdelen van de secundaire navigatie."
        }
      },
      "search-panel": {
        "background-color": {
          "$value": "{dsn.color.accent-1.bg-default}",
          "$type": "color",
          "$description": "Achtergrondkleur van het zoekpaneel."
        },
        "padding-block": {
          "$value": "{dsn.space.block.md}",
          "$type": "spacing",
          "$description": "Ruimte boven en onder de inhoud van het zoekpaneel."
        },
        "padding-inline": {
          "$value": "{dsn.space.inline.xl}",
          "$type": "spacing",
          "$description": "Ruimte aan begin en eind van de inhoud van het zoekpaneel."
        }
      },
      "compact": {
        "background-color": {
          "$value": "{dsn.color.neutral.bg-document}",
          "$type": "color",
          "$description": "Achtergrondkleur in variant ‘compact’."
        },
        "padding-block": {
          "$value": "{dsn.space.block.xl}",
          "$type": "spacing",
          "$description": "Ruimte boven en onder de inhoud in variant ‘compact’."
        },
        "padding-inline": {
          "$value": "{dsn.space.inline.xl}",
          "$type": "spacing",
          "$description": "Ruimte aan begin en eind van de inhoud in variant ‘compact’."
        }
      }
    }
  }
}
