{
  "dsn": {
    "breadcrumb-navigation": {
      "column-gap": {
        "$value": "{dsn.space.column.md}",
        "$type": "dimension",
        "$description": "Horizontale ruimte tussen de onderdelen."
      },
      "font-size": {
        "$value": "{dsn.text.font-size.sm}",
        "$type": "fontSize",
        "$description": "Lettergrootte."
      },
      "font-weight": {
        "$value": "{dsn.text.font-weight.default}",
        "$type": "fontWeight",
        "$description": "Lettergewicht."
      },
      "line-height": {
        "$value": "{dsn.text.line-height.sm}",
        "$type": "lineHeight",
        "$description": "Regelafstand."
      },
      "current": {
        "color": {
          "$value": "{dsn.color.neutral.color-subtle}",
          "$type": "color",
          "$description": "Voorgrondkleur voor de huidige pagina."
        }
      },
      "item": {
        "padding-block": {
          "$value": "{dsn.space.block.sm}",
          "$type": "dimension",
          "$description": "Ruimte boven en onder de inhoud van een item."
        },
        "padding-inline": {
          "$value": "{dsn.space.none}",
          "$type": "dimension",
          "$description": "Ruimte aan begin en eind van de inhoud van een item."
        }
      },
      "link": {
        "color": {
          "$value": "{dsn.color.action-2.color-default}",
          "$type": "color",
          "$description": "Voorgrondkleur van de link."
        },
        "column-gap": {
          "$value": "{dsn.space.text.xs}",
          "$type": "dimension",
          "$description": "Horizontale ruimte tussen de onderdelen van de link."
        },
        "text-decoration-line": {
          "$value": "underline",
          "$type": "other",
          "$description": "Tekstdecoratie, zoals onderstreping, van de link."
        },
        "text-underline-offset": {
          "$value": "4px",
          "$type": "dimension",
          "$description": "Afstand tussen tekst en onderstreping van de link."
        },
        "text-decoration-thickness": {
          "$value": "auto",
          "$type": "other",
          "$description": "Lijndikte van de onderstreping van de link."
        },
        "hover": {
          "color": {
            "$value": "{dsn.color.action-2.color-hover}",
            "$type": "color",
            "$description": "Voorgrondkleur van de link bij ‘hover’ status."
          },
          "text-decoration-line": {
            "$value": "none",
            "$type": "other",
            "$description": "Tekstdecoratie, zoals onderstreping, van de link bij ‘hover’ status."
          }
        },
        "active": {
          "color": {
            "$value": "{dsn.color.action-2.color-active}",
            "$type": "color",
            "$description": "Voorgrondkleur van de link bij ‘active’ status."
          },
          "text-decoration-line": {
            "$value": "none",
            "$type": "other",
            "$description": "Tekstdecoratie, zoals onderstreping, van de link bij ‘active’ status."
          }
        }
      },
      "separator": {
        "color": {
          "$value": "{dsn.color.neutral.color-subtle}",
          "$type": "color",
          "$description": "Voorgrondkleur van het scheidingsteken."
        },
        "size": {
          "$value": "{dsn.icon.size.sm}",
          "$type": "dimension",
          "$description": "Grootte van het scheidingsteken."
        }
      },
      "icon": {
        "size": {
          "$value": "{dsn.icon.size.sm}",
          "$type": "dimension",
          "$description": "Grootte van het icoon."
        }
      }
    }
  }
}
