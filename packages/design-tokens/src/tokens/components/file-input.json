{
  "dsn": {
    "file-input": {
      "color": {
        "$value": "{dsn.form-control.placeholder.color}",
        "$type": "color",
        "$description": "Voorgrondkleur."
      },
      "column-gap": {
        "$value": "{dsn.space.text.lg}",
        "$type": "dimension",
        "$description": "Horizontale ruimte tussen de onderdelen."
      },
      "font-family": {
        "$value": "{dsn.form-control.font-family}",
        "$type": "fontFamily",
        "$description": "Lettertype."
      },
      "font-size": {
        "$value": "{dsn.form-control.font-size}",
        "$type": "fontSize",
        "$description": "Lettergrootte."
      },
      "font-weight": {
        "$value": "{dsn.form-control.font-weight}",
        "$type": "fontWeight",
        "$description": "Lettergewicht."
      },
      "line-height": {
        "$value": "{dsn.form-control.line-height}",
        "$type": "lineHeight",
        "$description": "Regelafstand."
      },
      "min-block-size": {
        "$value": "{dsn.pointer-target.min-block-size}",
        "$type": "dimension",
        "$description": "Minimale hoogte."
      },
      "min-inline-size": {
        "$value": "{dsn.pointer-target.min-inline-size}",
        "$type": "dimension",
        "$description": "Minimale breedte."
      },
      "disabled": {
        "color": {
          "$value": "{dsn.form-control.disabled.color}",
          "$type": "color",
          "$description": "Voorgrondkleur bij ‘disabled’ status."
        }
      }
    }
  }
}
