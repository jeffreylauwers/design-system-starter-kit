{
  "dsn": {
    "progress-bar": {
      "color": {
        "track": {
          "$value": "{dsn.color.neutral.bg-default}",
          "$type": "color",
          "$description": "Kleur van de baan waarover de voortgang loopt."
        },
        "fill": {
          "$value": "{dsn.color.accent-1-inverse.bg-default}",
          "$type": "color",
          "$description": "Kleur van het deel dat de voortgang toont."
        }
      },
      "block-size": {
        "$value": "8px",
        "$type": "dimension",
        "$description": "Hoogte."
      },
      "border-radius": {
        "$value": "{dsn.border.radius.round}",
        "$type": "borderRadius",
        "$description": "Hoekafronding."
      },
      "gap": {
        "header": {
          "$value": "{dsn.space.block.xs}",
          "$type": "spacing",
          "$description": "Ruimte tussen de tekst boven de balk en de balk."
        },
        "footer": {
          "$value": "{dsn.space.block.xs}",
          "$type": "spacing",
          "$description": "Ruimte tussen de balk en de tekst eronder."
        }
      }
    }
  }
}
