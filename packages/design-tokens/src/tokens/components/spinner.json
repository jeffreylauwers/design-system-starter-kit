{
  "dsn": {
    "spinner": {
      "size": {
        "$value": "{dsn.icon.size.md}",
        "$type": "dimension",
        "$description": "Grootte."
      },
      "size-large": {
        "$value": "calc({dsn.icon.size.md} * 2)",
        "$type": "dimension",
        "$description": "Grootte in maat ‘large’."
      },
      "stroke-width": {
        "$value": "{dsn.border.width.medium}",
        "$type": "dimension",
        "$description": "Lijndikte van de draaiende boog."
      },
      "color": {
        "$value": "{dsn.color.accent-1.color-default}",
        "$description": "Kleur van de draaiende boog."
      },
      "track-color": {
        "$value": "{dsn.color.neutral.bg-subtle}",
        "$description": "Kleur van de cirkel waarover de boog draait."
      },
      "duration": {
        "$value": "800ms",
        "$type": "duration",
        "$description": "Duur van één rotatie."
      },
      "gap-size": {
        "$value": "{dsn.space.inline.md}",
        "$description": "Ruimte tussen de spinner en het label."
      }
    }
  }
}
