          "$value": "{dsn.card.header.row-gap}",
          "$type": "spacing",
          "$description": "Verticale ruimte tussen directe kinderen van de pre-header, gelijk aan de header"
        }
      },
      "header": {
        "padding-block-start": {
          "$value": "{dsn.space.block.xl}",
          "$type": "spacing",
          "$description": "Bovenkant padding van de header (16px)"
