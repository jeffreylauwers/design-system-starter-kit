        "padding-block-start": {
          "$value": "{dsn.card.header.padding-block-start}",
          "$type": "spacing",
          "$description": "Bovenkant padding van de pre-header, gelijk aan de header. Media als direct kind bleedt hier doorheen."
        },
        "padding-block-end": {
          "$value": "{dsn.card.header.padding-block-end}",
          "$type": "spacing",
          "$description": "Onderkant padding van de pre-header, gelijk aan de header"
        },
        "padding-inline-start": {
          "$value": "{dsn.card.header.padding-inline-start}",
          "$type": "spacing",
          "$description": "Padding aan de beginzijde van de pre-header, gelijk aan de header"
