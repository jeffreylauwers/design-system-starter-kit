        "color": {
          "$value": "{dsn.color.neutral.color-document}",
          "$type": "color",
          "$description": "Kleur van de card-description"
        },
        "font-size": {
          "$value": "{dsn.text.font-size.md}",
          "$type": "fontSize",
          "$description": "Tekstgrootte van de card-description"
        },
        "line-height": {
          "$value": "{dsn.text.line-height.md}",
          "$type": "lineHeight",
          "$description": "Regelafstand van de card-description"
        }
      },
