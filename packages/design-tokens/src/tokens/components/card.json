      },
      "box-shadow-hover": {
        "$value": "{dsn.box-shadow.md}",
        "$type": "shadow",
        "$description": "Schaduw bij hover — hogere elevatie benadrukt interactiviteit"
      },
      "min-block-size": {
        "$value": "auto",
        "$type": "sizing",
        "$description": "Minimale hoogte van de card"
      },
