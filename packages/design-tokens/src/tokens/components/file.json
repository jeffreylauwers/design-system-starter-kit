{
  "dsn": {
    "file": {
      "background-color": {
        "$value": "{dsn.color.neutral.bg-document}",
        "$type": "color",
        "$description": "Achtergrondkleur."
      },
      "background-color-hover": {
        "$value": "{dsn.color.neutral.bg-elevated}",
        "$type": "color",
        "$description": "Achtergrondkleur bij ‘hover’ status."
      },
      "background-color-active": {
        "$value": "{dsn.color.neutral.bg-elevated}",
        "$type": "color",
        "$description": "Achtergrondkleur bij ‘active’ status."
      },
      "border-radius": {
        "$value": "{dsn.border.radius.md}",
        "$type": "dimension",
        "$description": "Hoekafronding."
      },
      "border-width": {
        "$value": "{dsn.border.width.thin}",
        "$type": "borderWidth",
        "$description": "Lijndikte van de rand."
      },
      "border-color": {
        "$value": "{dsn.color.neutral.border-subtle}",
        "$type": "color",
        "$description": "Lijnkleur van de rand."
      },
      "border-color-hover": {
        "$value": "{dsn.color.neutral.border-default}",
        "$type": "color",
        "$description": "Lijnkleur van de rand bij ‘hover’ status."
      },
      "border-color-active": {
        "$value": "{dsn.color.neutral.border-default}",
        "$type": "color",
        "$description": "Lijnkleur van de rand bij ‘active’ status."
      },
      "border-color-error": {
        "$value": "{dsn.color.negative.border-default}",
        "$type": "color",
        "$description": "Lijnkleur van de rand bij een fout."
      },
      "box-shadow": {
        "$value": "none",
        "$type": "shadow",
        "$description": "Schaduw."
      },
      "box-shadow-hover": {
        "$value": "{dsn.box-shadow.md}",
        "$type": "shadow",
        "$description": "Schaduw bij ‘hover’ status."
      },
      "padding-block": {
        "$value": "{dsn.space.block.lg}",
        "$type": "spacing",
        "$description": "Ruimte boven en onder de inhoud."
      },
      "padding-inline": {
        "$value": "{dsn.space.inline.xl}",
        "$type": "spacing",
        "$description": "Ruimte aan begin en eind van de inhoud."
      },
      "gap": {
        "$value": "{dsn.space.inline.lg}",
        "$type": "spacing",
        "$description": "Ruimte tussen de onderdelen."
      },
      "content": {
        "gap": {
          "$value": "{dsn.space.block.xs}",
          "$type": "spacing",
          "$description": "Ruimte tussen de onderdelen van het tekstdeel."
        }
      },
      "name": {
        "color": {
          "$value": "{dsn.color.neutral.color-default}",
          "$type": "color",
          "$description": "Tekstkleur van de naam."
        },
        "font-weight": {
          "$value": "{dsn.text.font-weight.bold}",
          "$type": "fontWeight",
          "$description": "Lettergewicht van de naam."
        }
      },
      "meta": {
        "color": {
          "$value": "{dsn.color.neutral.color-subtle}",
          "$type": "color",
          "$description": "Tekstkleur van de metagegevens."
        },
        "font-size": {
          "$value": "{dsn.text.font-size.md}",
          "$type": "fontSize",
          "$description": "Lettergrootte van de metagegevens."
        }
      },
      "media": {
        "size": {
          "$value": "calc({dsn.icon.size.md} * 2)",
          "$type": "dimension",
          "$description": "Grootte van het vierkante mediavlak voor een icoon of voorbeeld."
        },
        "border-radius": {
          "$value": "{dsn.border.radius.sm}",
          "$type": "dimension",
          "$description": "Hoekafronding van het mediavlak."
        },
        "background-color": {
          "$value": "{dsn.color.neutral.bg-default}",
          "$type": "color",
          "$description": "Achtergrondkleur van het mediavlak."
        },
        "icon": {
          "color": {
            "$value": "{dsn.color.neutral.color-subtle}",
            "$type": "color",
            "$description": "Kleur van het icoon van het mediavlak."
          },
          "size": {
            "$value": "{dsn.icon.size.md}",
            "$type": "dimension",
            "$description": "Grootte van het icoon van het mediavlak."
          }
        }
      },
      "status-icon": {
        "color": {
          "$value": "{dsn.color.positive.color-default}",
          "$type": "color",
          "$description": "Kleur van het statusicoon."
        },
        "size": {
          "$value": "{dsn.icon.size.md}",
          "$type": "dimension",
          "$description": "Grootte van het statusicoon."
        }
      }
    }
  }
}
