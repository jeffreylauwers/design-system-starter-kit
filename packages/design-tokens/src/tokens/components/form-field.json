        },
        "border-inline-start-width": {
          "$value": "{dsn.border.width.medium}",
          "$type": "dimension",
          "$description": "Lijndikte van de rand aan de beginkant bij een ongeldige invoer."
        },
        "padding-inline-start": {
          "$value": "{dsn.space.inline.xl}",
          "$type": "dimension",
          "$description": "Ruimte aan het begin van de inhoud bij een ongeldige invoer."
        }
      }
    }
