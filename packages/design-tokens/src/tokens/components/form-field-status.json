{
  "dsn": {
    "form-field-status": {
      "color": {
        "$value": "{dsn.color.neutral.color-subtle}",
        "$type": "color",
        "$description": "Tekstkleur van de veldstatus (subtiel voor niet-kritieke informatie)"
      },
      "font-family": {
        "$value": "{dsn.text.font-family.default}",
