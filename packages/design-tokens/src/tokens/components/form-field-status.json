        "$description": "Font-familie van de veldstatus"
      },
      "font-size": {
        "$value": "{dsn.text.font-size.md}",
        "$type": "fontSize",
        "$description": "Font-size van de veldstatus"
      },
      "font-weight": {
        "$value": "{dsn.text.font-weight.default}",
