{
  "dsn": {
    "data-list": {
      "row": {
        "border-block-end-color": {
          "$value": "{dsn.color.neutral.border-subtle}",
          "$type": "color",
          "$description": "Lijnkleur van de rand aan de onderkant van een rij."
        },
        "border-block-end-width": {
          "$value": "{dsn.border.width.thin}",
          "$type": "dimension",
          "$description": "Lijndikte van de rand aan de onderkant van een rij."
        },
        "gap": {
          "$value": "{dsn.space.inline.lg}",
          "$type": "dimension",
          "$description": "Ruimte tussen de onderdelen van een rij."
        },
        "padding-block": {
          "$value": "{dsn.space.block.lg}",
          "$type": "dimension",
          "$description": "Ruimte boven en onder de inhoud van een rij."
        }
      },
      "key": {
        "color": {
          "$value": "{dsn.color.neutral.color-document}",
          "$type": "color",
          "$description": "Tekstkleur van de key."
        },
        "font-weight": {
          "$value": "{dsn.text.font-weight.bold}",
          "$type": "fontWeight",
          "$description": "Lettergewicht van de key."
        },
        "basis": {
          "$value": "30%",
          "$type": "dimension",
          "$description": "Breedte van de kolom met keys."
        }
      },
      "value": {
        "color": {
          "$value": "{dsn.color.neutral.color-document}",
          "$type": "color",
          "$description": "Tekstkleur van de value."
        }
      },
      "actions": {
        "gap": {
          "$value": "{dsn.space.inline.3xl}",
          "$type": "dimension",
          "$description": "Ruimte tussen de onderdelen van de acties."
        },
        "margin-block-start-stacked": {
          "$value": "{dsn.space.block.md}",
          "$type": "dimension",
          "$description": "Ruimte boven de acties als key en value onder elkaar staan."
        }
      }
    }
  }
}
