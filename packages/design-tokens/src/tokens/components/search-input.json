{
  "dsn": {
    "search-input": {
      "icon-gap": {
        "$value": "{dsn.space.text.md}",
        "$type": "dimension",
        "$description": "Ruimte tussen icoon en tekst."
      },
      "icon-size": {
        "$value": "{dsn.icon.size.md}",
        "$type": "dimension",
        "$description": "Grootte van het icoon."
      },
      "padding-inline-start-with-icon": {
        "$value": "calc({dsn.search-input.icon-size} + {dsn.search-input.icon-gap} + {dsn.form-control.padding-inline-start})",
        "$type": "dimension",
        "$description": "Ruimte aan het begin van de inhoud als er een icoon voor de tekst staat."
      }
    }
  }
}
