{
  "dsn": {
    "hero": {
      "block-size": {
        "$value": "70svh",
        "$type": "dimension",
        "$description": "Hoogte."
      },
      "min-block-size": {
        "$value": "400px",
        "$type": "dimension",
        "$description": "Minimale hoogte, zodat het vlak bij weinig inhoud niet te klein wordt."
      },
      "padding-block": {
        "$value": "{dsn.space.block.4xl}",
        "$type": "spacing",
        "$description": "Ruimte boven en onder de inhoud."
      },
      "padding-inline": {
        "$value": "{dsn.space.inline.xl}",
        "$type": "spacing",
        "$description": "Ruimte aan begin en eind van de inhoud."
      },
      "background-color": {
        "default": {
          "$value": "{dsn.color.accent-1.bg-default}",
          "$type": "color",
          "$description": "Achtergrondkleur in variant ‘default’."
        },
        "inverse": {
          "$value": "{dsn.color.accent-1-inverse.bg-default}",
          "$type": "color",
          "$description": "Achtergrondkleur in variant ‘inverse’."
        }
      },
      "color": {
        "default": {
          "$value": "{dsn.color.accent-1.color-default}",
          "$type": "color",
          "$description": "Voorgrondkleur in variant ‘default’."
        },
        "inverse": {
          "$value": "{dsn.color.accent-1-inverse.color-default}",
          "$type": "color",
          "$description": "Voorgrondkleur in variant ‘inverse’."
        }
      },
      "border-block-width": {
        "$value": "{dsn.border.width.thin}",
        "$type": "dimension",
        "$description": "Lijndikte van de randen boven en onder."
      },
      "image": {
        "blend-color": {
          "$value": "{dsn.color.accent-1-inverse.bg-default}",
          "$type": "color",
          "$description": "Kleur die met de afbeelding wordt gemengd in de variant met kleurmenging."
        }
      }
    }
  }
}
