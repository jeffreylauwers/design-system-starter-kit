        },
        "xl": {
          "$value": "fluid({dsn.text.font-size.min.xl}, {dsn.text.font-size.max.xl})",
          "$description": "Lettergrootte voor tussenkoppen."
        },
        "2xl": {
          "$value": "fluid({dsn.text.font-size.min.2xl}, {dsn.text.font-size.max.2xl})",
          "$description": "Lettergrootte voor sectiekoppen."
        },
        "3xl": {
          "$value": "fluid({dsn.text.font-size.min.3xl}, {dsn.text.font-size.max.3xl})",
          "$description": "Lettergrootte voor de hoofdkop van een pagina."
        },
        "4xl": {
          "$value": "fluid({dsn.text.font-size.min.4xl}, {dsn.text.font-size.max.4xl})",
