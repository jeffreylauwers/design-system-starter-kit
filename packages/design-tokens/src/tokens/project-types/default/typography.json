{
  "dsn": {
    "text": {
      "font-size": {
        "sm": {
          "$value": "fluid({dsn.text.font-size.min.sm}, {dsn.text.font-size.max.sm})",
          "$description": "Kleine lettergrootte, voor ondersteunende tekst zoals beschrijvingen en metadata."
        },
        "md": {
          "$value": "fluid({dsn.text.font-size.min.md}, {dsn.text.font-size.max.md})",
