{
  "name": "@dsn-starter-kit/core",
  "version": "3.2.0",
  "description": "Core styles and utilities for the design system",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "style": "dist/core.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./css": {
      "types": "./css.d.ts",
      "default": "./dist/core.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "css.d.ts"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:css": "mkdir -p dist && cat src/styles/reset.css src/styles/utilities.css > dist/core.css",
    "build:js": "tsdown",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "keywords": [
    "design-system",
    "css",
    "utilities",
    "reset"
  ],
  "author": "Jeffrey Lauwers",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dsn-starter-kit/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsdown": "^0.22.14"
  }
}
